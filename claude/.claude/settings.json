{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "terraform *",
      "tflint *",
      "gh *",
      "git *",
      "uv *",
      "databricks *"
    ],
    "network": {
      "allowedDomains": [
        "*"
      ],
      "deniedDomains": [
        "gist.github.com",
        "pastebin.com",
        "*.ngrok.io",
        "*.ngrok-free.app",
        "webhook.site",
        "transfer.sh"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform init *)",
      "Bash(terraform plan *)",
      "Bash(terraform show *)",
      "Bash(terraform output *)",
      "Bash(terraform providers *)",
      "Bash(terraform graph *)",
      "Bash(terraform version)",
      "Bash(terraform state list *)",
      "Bash(terraform state show *)",
      "Bash(tflint *)",
      "Bash(uv --version)",
      "Bash(uv sync)",
      "Bash(uv sync --frozen)",
      "Bash(uv lock)",
      "Bash(uv lock --check)",
      "Bash(uv tree:*)",
      "Bash(uv pip list:*)",
      "Bash(uv pip show:*)",
      "Bash(uv python list:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pyright:*)",
      "Bash(databricks --version)",
      "Bash(databricks help *)",
      "Bash(databricks current-user me *)",
      "Bash(databricks auth profiles *)",
      "Bash(databricks auth describe *)",
      "Bash(databricks clusters list *)",
      "Bash(databricks clusters get *)",
      "Bash(databricks jobs list *)",
      "Bash(databricks jobs get *)",
      "Bash(databricks jobs list-runs *)",
      "Bash(databricks jobs get-run *)",
      "Bash(databricks jobs get-run-output *)",
      "Bash(databricks pipelines list-pipelines *)",
      "Bash(databricks pipelines get *)",
      "Bash(databricks warehouses list *)",
      "Bash(databricks warehouses get *)",
      "Bash(databricks catalogs list *)",
      "Bash(databricks catalogs get *)",
      "Bash(databricks schemas list *)",
      "Bash(databricks schemas get *)",
      "Bash(databricks tables list *)",
      "Bash(databricks tables get *)",
      "Bash(databricks workspace list *)",
      "Bash(databricks workspace get-status *)",
      "Bash(databricks workspace export *)",
      "Bash(databricks fs ls *)",
      "Bash(databricks fs cat *)",
      "Bash(databricks bundle validate *)",
      "Bash(databricks bundle summary *)",
      "Bash(databricks bundle schema *)",
      "Bash(databricks secrets list-scopes *)",
      "Bash(databricks secrets list-secrets *)"
    ],
    "ask": [
      "Bash(databricks bundle deploy *)",
      "Bash(databricks bundle run *)",
      "Bash(databricks jobs run-now *)",
      "Bash(databricks jobs submit *)",
      "Bash(databricks jobs cancel-run *)",
      "Bash(databricks clusters start *)",
      "Bash(databricks clusters restart *)",
      "Bash(databricks clusters create *)",
      "Bash(databricks clusters edit *)",
      "Bash(databricks pipelines start-update *)",
      "Bash(databricks workspace import *)",
      "Bash(databricks workspace mkdirs *)",
      "Bash(databricks fs cp *)",
      "Bash(databricks fs mkdir *)",
      "Bash(databricks repos *)",
      "Bash(databricks sync *)",
      "Bash(databricks api *)"
    ],
    "deny": [
