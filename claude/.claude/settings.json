{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": ["*"],
      "deniedDomains": [
        "gist.github.com",
        "pastebin.com",
        "*.ngrok.io",
        "*.ngrok-free.app",
        "webhook.site",
        "transfer.sh"
      ]
    }
  },
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform init *)",
      "Bash(terraform plan *)",
      "Bash(terraform show *)",
      "Bash(terraform output *)",
      "Bash(terraform providers *)",
      "Bash(terraform graph *)",
      "Bash(terraform version)",
      "Bash(terraform state list *)",
      "Bash(terraform state show *)",
      "Bash(tflint *)"
    ],
    "deny": [
      "Bash(terraform destroy *)",
      "Bash(terraform * -auto-approve*)",
      "Bash(terraform apply -destroy *)",
      "Bash(terraform state push *)",
      "Bash(terraform force-unlock *)",
      "Bash(terraform -chdir=*)"
    ],
    "ask": [
      "Read(./.env)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(terrafom apply:*)",
      "Bash(terraform apply *)",
      "Bash(terraform import *)",
      "Bash(terraform state mv *)",
      "Bash(terraform state rm *)",
      "Bash(terraform workspace *)",
      "Bash(terraform taint *)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/.terraform/**)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {
    "databricks@databricks-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "databricks-agent-skills": {
      "source": {
        "source": "github",
        "repo": "databricks/databricks-agent-skills"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "dark",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  }
}
