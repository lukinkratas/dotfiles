{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [ "*" ],
      "deniedDomains": [
        "gist.github.com",
        "pastebin.com",
        "*.ngrok.io",
        "*.ngrok-free.app",
        "webhook.site",
        "transfer.sh"
      ]
    }
  },
  "permissions": {
    "deny": [
      "mcp__linear-server__delete_comment",
      "mcp__linear-server__delete_attachment",
      "mcp__linear-server__delete_status_update",
      "mcp__linear-server__delete_diff_comment",
      "Bash(terraform *destroy*)",
      "Bash(databricks bundle destroy *)",
      "Edit(~/.databrickscfg)"
    ],
    "allow": [
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform plan *)",
      "Bash(terraform init *)",
      "Bash(databricks bundle validate *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/lukin/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {
    "databricks@databricks-agent-skills": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "databricks-agent-skills": {
      "source": {
        "source": "github",
        "repo": "databricks/databricks-agent-skills"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "dark"
}
