{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "terraform *",
      "tflint *",
      "gh *",
      "git *",
      "uv *"
    ],
    "network": {
      "allowedDomains": [
        "*"
      ],
      "deniedDomains": [
        "gist.github.com",
        "pastebin.com",
        "*.ngrok.io",
        "*.ngrok-free.app",
        "webhook.site",
        "transfer.sh"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform init *)",
      "Bash(terraform plan *)",
      "Bash(terraform show *)",
      "Bash(terraform output *)",
      "Bash(terraform providers *)",
      "Bash(terraform graph *)",
      "Bash(terraform version)",
      "Bash(terraform state list *)",
      "Bash(terraform state show *)",
      "Bash(tflint *)",
      "Bash(uv --version)",
      "Bash(uv sync)",
      "Bash(uv sync --frozen)",
      "Bash(uv lock)",
      "Bash(uv lock --check)",
      "Bash(uv tree:*)",
      "Bash(uv pip list:*)",
      "Bash(uv pip show:*)",
      "Bash(uv python list:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pyright:*)"
    ],
    "deny": [
      "Bash(terraform destroy *)",
      "Bash(terraform * -auto-approve*)",
      "Bash(terraform apply -destroy *)",
      "Bash(terraform state push *)",
      "Bash(terraform force-unlock *)",
      "Bash(terraform -chdir=*)",
      "mcp__linear-server__delete_comment",
      "mcp__linear-server__delete_attachment",
      "mcp__linear-server__delete_status_update",
      "mcp__linear-server__delete_diff_comment",
      "Bash(uv publish:*)",
      "Bash(uv self update:*)",
      "Bash(uv tool install:*)",
      "Bash(uv tool uninstall:*)",
      "Bash(uv cache clean:*)",
      "Bash(uv cache prune:*)"
    ],
    "ask": [
      "Read(**/.env)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform apply *)",
      "Bash(terraform import *)",
      "Bash(terraform state mv *)",
      "Bash(terraform state rm *)",
      "Bash(terraform workspace *)",
      "Bash(terraform taint *)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/.terraform/**)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv lock --upgrade:*)",
      "Bash(uv sync --upgrade:*)",
      "Bash(uv pip install:*)",
      "Bash(uv pip uninstall:*)",
      "Bash(uv venv:*)",
      "Bash(uv python install:*)",
      "Bash(uv run:*)",
      "Bash(uvx:*)",
      "Bash(uv tool run:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/lukin/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {
    "databricks@databricks-agent-skills": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "databricks-agent-skills": {
      "source": {
        "source": "github",
        "repo": "databricks/databricks-agent-skills"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "dark"
}
