{
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "extraKnownMarketplaces": {
    "databricks-agent-skills": {
      "source": {
        "source": "github",
        "repo": "databricks/databricks-agent-skills"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "dark",
  "enabledPlugins": {
    "databricks@databricks-agent-skills": true
  },
  "outputStyle": "Concise",
  "permissions": {
    "deny": [
      "Read(./.env)"
    ],
    "allow": [
        "Bash(git checkout:*)",
        "Bash(git add:*)",
        "Bash(git commit:*)",
        "Bash(gh pr view:*)",
        "Bash(gh pr list:*)"
    ],
    "ask": [
        "Bash(git push:*)",
        "Bash(gh pr create:*)"
    ]
  }
}
