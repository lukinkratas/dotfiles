      "Bash(terraform * -auto-approve*)",
      "Bash(terraform apply -destroy *)",
      "Bash(terraform state push *)",
      "Bash(terraform force-unlock *)",
      "Bash(terraform -chdir=*)",
      "mcp__linear-server__delete_comment",
      "mcp__linear-server__delete_attachment",
      "mcp__linear-server__delete_status_update",
      "mcp__linear-server__delete_diff_comment",
      "Bash(uv publish:*)",
      "Bash(uv self update:*)",
      "Bash(uv tool install:*)",
      "Bash(uv tool uninstall:*)",
      "Bash(uv cache clean:*)",
      "Bash(uv cache prune:*)",
      "Bash(databricks auth token *)",
      "Bash(databricks auth login *)",
      "Bash(databricks configure *)",
      "Bash(databricks tokens *)",
      "Bash(databricks token-management *)",
      "Bash(databricks secrets get-secret *)",
      "Bash(databricks secrets put-secret *)",
      "Bash(databricks secrets delete-* *)",
      "Bash(databricks bundle destroy *)",
      "Bash(databricks clusters delete *)",
      "Bash(databricks clusters permanent-delete *)",
      "Bash(databricks jobs delete *)",
      "Bash(databricks pipelines delete *)",
      "Bash(databricks workspace delete *)",
      "Bash(databricks fs rm *)",
      "Bash(databricks catalogs delete *)",
      "Bash(databricks schemas delete *)",
      "Bash(databricks tables delete *)",
      "Bash(databricks permissions *)",
      "Bash(databricks grants update *)",
      "Bash(databricks users *)",
      "Bash(databricks groups *)",
      "Bash(databricks service-principals *)",
      "Bash(databricks * --profile prod*)",
      "Bash(databricks * -p prod*)",
      "Read(~/.databrickscfg)",
      "Edit(~/.databrickscfg)"
    ],
    "ask": [
      "Read(**/.env)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform apply *)",
      "Bash(terraform import *)",
      "Bash(terraform state mv *)",
      "Bash(terraform state rm *)",
      "Bash(terraform workspace *)",
      "Bash(terraform taint *)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/.terraform/**)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv lock --upgrade:*)",
      "Bash(uv sync --upgrade:*)",
      "Bash(uv pip install:*)",
      "Bash(uv pip uninstall:*)",
      "Bash(uv venv:*)",
      "Bash(uv python install:*)",
      "Bash(uv run:*)",
      "Bash(uvx:*)",
      "Bash(uv tool run:*)",
      "Bash(databricks bundle deploy *)",
      "Bash(databricks bundle run *)",
      "Bash(databricks jobs run-now *)",
      "Bash(databricks jobs submit *)",
      "Bash(databricks jobs cancel-run *)",
      "Bash(databricks clusters start *)",
      "Bash(databricks clusters restart *)",
      "Bash(databricks clusters create *)",
      "Bash(databricks clusters edit *)",
      "Bash(databricks pipelines start-update *)",
      "Bash(databricks workspace import *)",
      "Bash(databricks workspace mkdirs *)",
      "Bash(databricks fs cp *)",
      "Bash(databricks fs mkdir *)",
      "Bash(databricks repos *)",
      "Bash(databricks sync *)",
      "Bash(databricks api *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/lukin/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {
    "databricks@databricks-agent-skills": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "databricks-agent-skills": {
      "source": {
        "source": "github",
        "repo": "databricks/databricks-agent-skills"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "dark"
}
